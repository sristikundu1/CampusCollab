{
  "name": "campuscollab-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CampusCollab modular-monolith backend foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 tests/unit",
    "test:smoke:profile": "node scripts/smoke-profile-api.js",
    "test:smoke:gigs": "node scripts/smoke-gigs-api.js",
    "check": "node scripts/check-project.js",
    "db:verify-indexes": "node scripts/verify-database-indexes.js",
    "db:seed:uiu": "node scripts/seed-uiu.js",
    "db:seed:skills": "node scripts/seed-skills.js",
    "db:migrate:test": "node scripts/migrate-test-database.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.4",
    "nodemailer": "^9.0.6",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
