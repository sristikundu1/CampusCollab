{
  "name": "campuscollab-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CampusCollab modular-monolith backend foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 tests/unit",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"api/**/*.js\"",
    "test:smoke:profile": "node scripts/smoke-profile-api.js",
    "test:smoke:gigs": "node scripts/smoke-gigs-api.js",
    "test:smoke:projects": "node scripts/smoke-projects-api.js",
    "test:integration:projects": "node scripts/verify-project-participation-concurrency.js",
    "check": "node scripts/check-project.js",
    "db:verify-indexes": "node scripts/verify-database-indexes.js",
    "db:ensure-project-indexes": "node scripts/ensure-project-participation-indexes.js",
    "db:ensure-messaging-indexes": "node scripts/ensure-messaging-indexes.js",
    "test:integration:messaging": "node scripts/verify-messaging-database.js",
    "db:ensure-notification-indexes": "node scripts/ensure-notification-indexes.js",
    "test:integration:notifications": "node scripts/verify-notification-database.js",
    "db:seed:uiu": "node scripts/seed-uiu.js",
    "db:seed:skills": "node scripts/seed-skills.js",
    "db:migrate:test": "node scripts/migrate-test-database.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.4",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
