# CampusCollab environment template
# Copy this file to .env locally and replace every required placeholder.
# Never commit .env or real credentials.

# Application (public/non-secret)
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false

# MongoDB (secret because the URI normally contains credentials)
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=CampusCollab
# Optional comma-separated resolver IPs; leave empty unless local DNS blocks Atlas SRV lookups.
MONGODB_DNS_SERVERS=

# Opaque server-side sessions and CSRF protection (secret)
SESSION_SECRET=generate_a_long_random_secret_here
CSRF_SECRET=generate_a_different_long_random_secret_here

# Session behavior (public/non-secret)
SESSION_COOKIE_NAME=campuscollab_session
SESSION_TTL_DAYS=30
# Email verification is intentionally disabled during the current development phase.
REQUIRE_EMAIL_VERIFICATION=false

# Email delivery (credentials are secret; sender address is configuration)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
EMAIL_FROM=your_sender_email_here

# Redis (optional locally, required in production for distributed rate limiting)
REDIS_URL=your_redis_connection_string_here

# Cloudinary file storage (reserved for later file-upload implementation)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_FOLDER=campuscollab

# Upload policy (public/non-secret)
MAX_UPLOAD_BYTES=5242880
